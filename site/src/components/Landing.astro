---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import mongodb from "../assets/databases/mongodb.svg";
import mysql from "../assets/databases/mysql.svg";
import postgresql from "../assets/databases/postgresql.svg";
import redis from "../assets/databases/redis.svg";
import sqlite from "../assets/databases/sqlite.svg";
import sqlserver from "../assets/databases/sqlserver.svg";
import anthropic from "../assets/providers/anthropic.svg";
import compatible from "../assets/providers/compatible.svg";
import ollama from "../assets/providers/ollama.svg";
import openai from "../assets/providers/openai.svg";
import openrouter from "../assets/providers/openrouter.svg";
import { links, messages, platforms, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale];
const other = messages[t.other.locale];
const year = new Date().getFullYear();
const [features, experience, ai, connections] = t.nav.sections.map((section) => section.id);
const kinds = t.connections.kinds;
const databases = [
  { icon: postgresql, name: "PostgreSQL", kind: kinds.relational },
  { icon: mysql, name: "MySQL", kind: kinds.relational },
  { icon: sqlite, name: "SQLite", kind: kinds.embedded },
  { icon: sqlserver, name: "SQL Server", kind: kinds.relational },
  { icon: mongodb, name: "MongoDB", kind: kinds.documents },
  { icon: redis, name: "Redis", kind: kinds.memory },
];
// Nomes de marca não se traduzem; só "outros compatíveis" vem do catálogo.
const providers = [
  { icon: openai, name: "OpenAI" },
  { icon: anthropic, name: "Anthropic" },
  { icon: openrouter, name: "OpenRouter" },
  { icon: ollama, name: "Ollama" },
  { icon: compatible, name: t.ai.stack.others },
];
// As telas do carrossel do topo: cada imagem em `assets/screens/` é um slide,
// na ordem do nome do arquivo (`01-editor.png`, `02-grid.png`…). O nome sem o
// número é a chave do texto em `preview.screens` de cada idioma, e sem ela o
// build falha: nenhuma tela entra sem texto alternativo. Sem imagens, fica o
// painel de exemplo.
const screenFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/screens/*.{png,jpg,jpeg,webp}", {
  eager: true,
});
const screens = Object.entries(screenFiles)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, module]) => {
    const key = path.replace(/^.*\//, "").replace(/\.\w+$/, "").replace(/^\d+[-_]/, "");
    const text = t.preview.screens[key];
    if (!text) throw new Error(`preview.screens.${key} falta no catálogo ${locale}`);
    return { key, image: module.default, ...text };
  });
---

<Base locale={locale}>
  <header class="wrap nav" id="top">
    <a class="brand" href="#top" aria-label={t.nav.home}>
      <span>bando<small>{t.footer.tagline}</small></span>
    </a>
    <nav class="nav-links" id="nav-links" aria-label={t.nav.label}>
      {t.nav.sections.map((section) => <a href={`#${section.id}`}>{section.label}</a>)}
      <a href={t.other.path} hreflang={other.lang} lang={other.lang}>{t.other.label}</a>
    </nav>
    <div class="nav-actions">
      <a class="btn btn-light" href={links.releases}>{t.nav.releases}</a>
      <button
        class="menu-toggle"
        id="menu-toggle"
        type="button"
        aria-controls="nav-links"
        aria-expanded="false"
        aria-label={t.nav.menuOpen}
        data-open-label={t.nav.menuOpen}
        data-close-label={t.nav.menuClose}
      >
        <svg width="23" height="23" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg>
      </button>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <div class="eyebrow"><i class="eyebrow-dot"></i> {t.hero.eyebrow}</div>
          <h1>{t.hero.title[0]}<br />{t.hero.title[1]} <span>{t.hero.title[2]}</span></h1>
          <p>{t.hero.lead}</p>
          <div class="hero-ctas">
            <div class="download" id="download">
              <a class="btn btn-dark" href={links.releases} data-label-for={t.hero.downloadFor}>
                <span class="download-label">{t.hero.download}</span>
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 3v9m0 0 3.5-3.5M10 12 6.5 8.5M4 14v2.5h12V14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </a>
              <label class="platform-picker" hidden>
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m6 8 4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                <select aria-label={t.hero.platform}>
                  {
                    platforms.map(({ id, name }) => (
                      <option value={id} data-href={links.downloads[id]}>
                        {name}
                      </option>
                    ))
                  }
                </select>
              </label>
            </div>
            <a class="btn btn-light" href={`#${features}`}>
              {t.hero.explore}
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 3v13m0 0 5-5m-5 5-5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </a>
          </div>
          <div class="hero-notes">
            {
              t.hero.notes.map((note) => (
                <span>
                  <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m4 10 4 4 8-8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  {note}
                </span>
              ))
            }
          </div>
        </div>

        {
          screens.length === 0 ? (
          <div class="product-window" role="img" aria-label={t.preview.label}>
            <div class="window-top" aria-hidden="true">
              <div class="window-dots"><i></i><i></i><i></i></div>
              <div class="window-tab"><span>◈</span><b>analytics.sql</b><span>×</span></div>
              <span>workspace / local</span>
            </div>
            <div class="window-body" aria-hidden="true">
              <div class="rail">
                <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="16" height="16" rx="2" stroke="currentColor" stroke-width="1.6"></rect><path d="M4 9h16M9 9v11" stroke="currentColor" stroke-width="1.4"></path></svg>
                <svg class="active" viewBox="0 0 24 24" fill="none"><path d="M5 5h14v14H5zM8 9h8M8 12h5M8 15h7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
                <svg viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h16M4 18h16M8 4v4M15 10v4M11 16v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
                <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.6"></circle><path d="M8 12h8M12 8v8" stroke="currentColor" stroke-width="1.6"></path></svg>
              </div>
              <div class="editor">
                <div class="editor-toolbar"><span>◈ &nbsp; analytics.sql</span><span class="run-pill">▶ {t.preview.run}</span></div>
                <div class="code-area">
                  <div><span class="ln">1</span><span class="kw">SELECT</span> <span class="fn">category</span>,</div>
                  <div><span class="ln">2</span> &nbsp;&nbsp;&nbsp;&nbsp; <span class="fn">COUNT</span>(*) <span class="kw">AS</span> <span class="str">total</span>,</div>
                  <div><span class="ln">3</span> &nbsp;&nbsp;&nbsp;&nbsp; <span class="fn">SUM</span>(revenue) <span class="kw">AS</span> <span class="str">revenue</span></div>
                  <div><span class="ln">4</span><span class="kw">FROM</span> <span class="fn">orders</span></div>
                  <div><span class="ln">5</span><span class="kw">WHERE</span> created_at &gt;= <span class="str">'2026-01-01'</span></div>
                  <div><span class="ln">6</span><span class="kw">GROUP BY</span> category</div>
                  <div><span class="ln">7</span><span class="kw">ORDER BY</span> revenue <span class="kw">DESC</span>;</div>
                </div>
                <div class="grid-head"><span>{t.preview.results} <small>· {t.preview.rows}</small></span><small>{t.preview.tools}</small></div>
                <table class="mini-grid">
                  <thead><tr><th>category</th><th>total</th><th>revenue</th></tr></thead>
                  <tbody>
                    {
                      t.preview.data.map((row) => (
                        <tr>
                          {row.map((cell) => (
                            <td>{cell}</td>
                          ))}
                        </tr>
                      ))
                    }
                  </tbody>
                </table>
                <div class="grid-status"><span>{t.preview.columns}</span><span>{t.preview.ready}</span></div>
              </div>
            </div>
            <div class="float-tag" aria-hidden="true">{t.preview.tag}<span>{t.preview.tagLine}</span></div>
          </div>
          ) : (
            <section class="product-window" aria-roledescription="carousel" aria-label={t.preview.carousel}>
              <div class="window-top">
                <div class="window-dots" aria-hidden="true"><i></i><i></i><i></i></div>
                <div class="screen-tabs" role="tablist" aria-label={t.preview.carousel}>
                  {screens.map((screen, i) => (
                    <button
                      class="screen-tab"
                      type="button"
                      role="tab"
                      id={`screen-tab-${screen.key}`}
                      aria-controls={`screen-${screen.key}`}
                      aria-selected={String(i === 0)}
                      tabindex={i === 0 ? 0 : -1}
                    >
                      {screen.tab}
                    </button>
                  ))}
                </div>
                <span class="window-path" aria-hidden="true">workspace / local</span>
              </div>
              <div class="screen-track">
                {screens.map((screen, i) => (
                  <div class="screen" id={`screen-${screen.key}`} role="tabpanel" aria-labelledby={`screen-tab-${screen.key}`}>
                    <Image
                      src={screen.image}
                      alt={screen.alt}
                      widths={[720, 1080, 1440]}
                      sizes="(max-width: 920px) 100vw, 640px"
                      loading="eager"
                      fetchpriority={i === 0 ? "high" : "low"}
                    />
                  </div>
                ))}
              </div>
            </section>
          )
        }
      </div>
    </section>

    <section class="proof">
      <div class="wrap proof-row">
        <div class="proof-label">{t.proof}</div>
        <div class="tech-list">
          {
            databases.map((db) => (
              <span>
                <Image class="tech-icon" src={db.icon} alt="" width={18} height={18} />
                {db.name}
              </span>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id={features}>
      <div class="wrap">
        <div class="section-head">
          <div class="eyebrow">{t.features.eyebrow}</div>
          <h2>{t.features.title[0]}<br />{t.features.title[1]}</h2>
          <p>{t.features.lead}</p>
        </div>
        <div class="feature-grid">
          {
            t.features.cards.map((card, i) => (
              <article class="feature-card">
                <div class="feature-icon" aria-hidden="true">
                  {i === 0 && <svg viewBox="0 0 24 24" fill="none"><path d="M13 2 4 14h7l-1 8 10-13h-7l0-7Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>}
                  {i === 1 && <svg viewBox="0 0 24 24" fill="none"><path d="m8 7-5 5 5 5M16 7l5 5-5 5M14 4l-4 16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>}
                  {i === 2 && <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.6" /><path d="M3 9h18M9 9v11M15 9v11" stroke="currentColor" stroke-width="1.4" /></svg>}
                  {i === 3 && <svg viewBox="0 0 24 24" fill="none"><path d="M4 5h16v14H4zM8 9h8M8 12h4M8 15h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /><path d="m16 14 2 2 3-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>}
                  {i === 4 && <svg viewBox="0 0 24 24" fill="none"><path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5" /></svg>}
                  {i === 5 && <svg viewBox="0 0 24 24" fill="none"><path d="M4 19V5M4 19h17M7 15l4-5 3 2 5-7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>}
                </div>
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </article>
            ))
          }
          <article class="feature-card wide">
            <div class="feature-icon" aria-hidden="true">
              <svg viewBox="0 -960 960 960" fill="currentColor"><path d="M120-240q-33 0-56.5-23.5T40-320q0-33 23.5-56.5T120-400h10.5q4.5 0 9.5 2l182-182q-2-5-2-9.5V-600q0-33 23.5-56.5T400-680q33 0 56.5 23.5T480-600q0 2-2 20l102 102q5-2 9.5-2h21q4.5 0 9.5 2l142-142q-2-5-2-9.5V-640q0-33 23.5-56.5T840-720q33 0 56.5 23.5T920-640q0 33-23.5 56.5T840-560h-10.5q-4.5 0-9.5-2L678-420q2 5 2 9.5v10.5q0 33-23.5 56.5T600-320q-33 0-56.5-23.5T520-400v-10.5q0-4.5 2-9.5L420-522q-5 2-9.5 2H400q-2 0-20-2L198-340q2 5 2 9.5v10.5q0 33-23.5 56.5T120-240Z"></path></svg>
            </div>
            <h3>{t.features.wide.title}</h3>
            <p>{t.features.wide.body}</p>
            <span class="wide-art logo" aria-hidden="true"></span>
          </article>
        </div>
      </div>
    </section>

    <section class="section showcase" id={experience}>
      <div class="wrap">
        <div class="section-head">
          <div class="eyebrow">{t.showcase.eyebrow}</div>
          <h2>{t.showcase.title[0]}<br />{t.showcase.title[1]}</h2>
          <p>{t.showcase.lead}</p>
        </div>
        <div class="showcase-layout">
          <div class="steps">
            {
              t.showcase.steps.map((step, i) => (
                <div class="step">
                  <div class="step-num">{String(i + 1).padStart(2, "0")}</div>
                  <div>
                    <h3>{step.title}</h3>
                    <p>{step.body}</p>
                  </div>
                </div>
              ))
            }
          </div>
          <div class="demo-panel">
            <div class="demo-toolbar">
              <span>◈ &nbsp; {t.showcase.panel}</span>
              <div class="demo-tabs" role="tablist" aria-label={t.showcase.tabsLabel}>
                {
                  t.showcase.demos.map((demo, i) => (
                    <button
                      class="demo-tab"
                      type="button"
                      role="tab"
                      id={`demo-tab-${i}`}
                      aria-controls={`demo-${i}`}
                      aria-selected={i === 0 ? "true" : "false"}
                    >
                      {demo.tab}
                    </button>
                  ))
                }
              </div>
            </div>
            {
              t.showcase.demos.map((demo, i) => (
                <div class="demo" role="tabpanel" id={`demo-${i}`} aria-labelledby={`demo-tab-${i}`} hidden={i !== 0}>
                  <div class="demo-content">
                    {demo.lines.map((line) => (
                      <div class="demo-line">
                        {line.map(([color, text]) => (color ? <span class={color}>{text}</span> : text))}
                      </div>
                    ))}
                  </div>
                  <div class="demo-footer">
                    <span>{demo.footLeft}</span>
                    <strong>{demo.footRight}</strong>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="section" id={ai}>
      <div class="wrap">
        <div class="section-head">
          <div class="eyebrow">{t.ai.eyebrow}</div>
          <h2>{t.ai.title[0]}<br />{t.ai.title[1]}</h2>
          <p>{t.ai.lead}</p>
        </div>
        <div class="ai-grid">
          <article class="ai-card">
            <div class="eyebrow">{t.ai.stack.eyebrow}</div>
            <h3>{t.ai.stack.title}</h3>
            <p>{t.ai.stack.body}</p>
            <div class="provider-pills">
              {
                providers.map((provider) => (
                  <span>
                    <Image class="provider-icon" src={provider.icon} alt="" width={16} height={16} />
                    {provider.name}
                  </span>
                ))
              }
            </div>
          </article>
          <article class="ai-card dark">
            <div class="eyebrow">{t.ai.audit.eyebrow}</div>
            <h3>{t.ai.audit.title}</h3>
            <p>{t.ai.audit.body}</p>
            <div class="audit-lines">
              {
                t.ai.audit.lines.map((line) => (
                  <div class="audit-line">
                    <i />
                    {line}
                  </div>
                ))
              }
            </div>
          </article>
        </div>
        <p class="note">{t.ai.note}</p>
      </div>
    </section>

    <section class="section connections" id={connections}>
      <div class="wrap connections-grid">
        <div class="db-cloud" role="list" aria-label={t.connections.label}>
          {
            databases.map((db) => (
              <div class="db-chip" role="listitem">
                <Image class="db-icon" src={db.icon} alt="" width={44} height={44} />
                {db.name}
                <small>{db.kind}</small>
              </div>
            ))
          }
        </div>
        <div class="connection-copy">
          <div class="eyebrow">{t.connections.eyebrow}</div>
          <h2>{t.connections.title[0]}<br />{t.connections.title[1]}</h2>
          <p>{t.connections.body}</p>
          <a class="btn btn-dark" href={links.releases}>
            {t.connections.button}
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11M10 5l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap footer-row">
      <a class="brand" href="#top" aria-label={t.nav.home}>
        <span>bando<small>{t.footer.tagline}</small></span>
      </a>
      <div class="footer-copy">© {year} {t.brand}. {t.footer.rights}</div>
      <div class="footer-links">
        <a href={links.support}>{t.footer.contact}</a>
        <a href={links.releases}>{t.footer.downloads}</a>
        <a href={t.other.path} hreflang={other.lang} lang={other.lang}>{t.other.label}</a>
      </div>
    </div>
  </footer>
</Base>

<script>
  // O menu do celular e as abas do painel de exemplo. O conteúdo das abas já
  // está no HTML; aqui só se troca qual aparece.
  const toggle = document.getElementById("menu-toggle");
  const nav = document.getElementById("nav-links");
  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) ?? "");
    };
    toggle.addEventListener("click", () => setOpen(!nav.classList.contains("open")));
    nav.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)));
  }

  // O botão de baixar do topo. Sem JS ele leva à página de versões; com JS,
  // ao instalador do sistema de quem visita, e o seletor ao lado troca o
  // sistema. Celular e tablet não têm instalador: o botão fica genérico e o
  // seletor, sem escolha, até a pessoa escolher.
  const download = document.getElementById("download");
  const downloadLink = download?.querySelector<HTMLAnchorElement>("a");
  const downloadLabel = download?.querySelector<HTMLElement>(".download-label");
  const picker = download?.querySelector<HTMLLabelElement>(".platform-picker");
  const platformSelect = picker?.querySelector("select");
  if (downloadLink && downloadLabel && picker && platformSelect) {
    const choose = () => {
      const option = platformSelect.selectedOptions[0];
      if (!option) return;
      downloadLink.href = option.dataset.href ?? downloadLink.href;
      downloadLabel.textContent = (downloadLink.dataset.labelFor ?? "").replace("{os}", option.text.trim());
    };
    platformSelect.value = detectPlatform() ?? "";
    platformSelect.addEventListener("change", choose);
    picker.hidden = false;
    choose();
  }

  function detectPlatform(): string | null {
    // `userAgentData` só existe nos navegadores Chromium; os outros ficam com
    // `platform` e o user agent.
    const nav = navigator as Navigator & { userAgentData?: { platform: string; mobile: boolean } };
    const ua = navigator.userAgent.toLowerCase();
    const platform = (nav.userAgentData?.platform || navigator.platform || "").toLowerCase();
    if (nav.userAgentData?.mobile || /android|iphone|ipad|ipod|cros/.test(ua)) return null;
    // O iPad se apresenta como Mac; o toque é o que o separa.
    if (platform.includes("mac")) return navigator.maxTouchPoints > 1 ? null : "macos";
    if (platform.includes("win")) return "windows";
    if (platform.includes("linux")) return "linux";
    return null;
  }

  // O carrossel de telas do topo. Sem JS ele ainda funciona: as telas ficam
  // lado a lado num trilho com scroll-snap. A troca automática é a barra que
  // enche sob a aba ativa (`screen-timer` em styles.css): quando ela termina,
  // vem a próxima tela. Para no primeiro toque, clique, tecla ou rolagem,
  // pausa com o mouse ou o foco em cima e não existe para quem pede menos
  // movimento, que fica sem a animação e portanto sem o fim dela.
  const track = document.querySelector<HTMLElement>(".screen-track");
  const screenTabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".screen-tab"));
  const frame = track?.closest<HTMLElement>(".product-window");
  if (track && frame && screenTabs.length > 1) {
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const slides = Array.from(track.children);
    let current = 0;
    const select = (index: number) => {
      current = index;
      screenTabs.forEach((tab, i) => {
        tab.setAttribute("aria-selected", String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
      });
      slides.forEach((slide, i) => slide.toggleAttribute("inert", i !== index));
    };
    const show = (index: number) => {
      track.scrollTo({ left: index * track.clientWidth, behavior: reduced.matches ? "auto" : "smooth" });
      select(index);
    };
    select(0);

    let settle = 0;
    track.addEventListener("scroll", () => {
      clearTimeout(settle);
      settle = window.setTimeout(() => select(Math.round(track.scrollLeft / track.clientWidth)), 120);
    });
    screenTabs.forEach((tab, i) => {
      tab.addEventListener("click", () => show(i));
      tab.addEventListener("keydown", (event) => {
        const last = screenTabs.length - 1;
        const next = { ArrowRight: i === last ? 0 : i + 1, ArrowLeft: i === 0 ? last : i - 1, Home: 0, End: last }[event.key];
        if (next === undefined) return;
        event.preventDefault();
        show(next);
        screenTabs[next].focus();
      });
    });

    if (!reduced.matches) frame.classList.add("autoplay");
    const stop = () => frame.classList.remove("autoplay");
    const setPaused = (paused: boolean) => frame.classList.toggle("paused", paused);
    for (const type of ["pointerdown", "keydown", "wheel"]) frame.addEventListener(type, stop, { passive: true });
    frame.addEventListener("mouseenter", () => setPaused(true));
    frame.addEventListener("mouseleave", () => setPaused(frame.contains(document.activeElement)));
    frame.addEventListener("focusin", () => setPaused(true));
    frame.addEventListener("focusout", () => setPaused(frame.matches(":hover")));
    screenTabs.forEach((tab) =>
      tab.addEventListener("animationend", (event) => {
        if (event.animationName === "screen-timer" && frame.classList.contains("autoplay")) {
          show((current + 1) % slides.length);
        }
      }),
    );
  }

  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".demo-tab"));
  for (const tab of tabs) {
    tab.addEventListener("click", () => {
      for (const other of tabs) {
        const selected = other === tab;
        other.setAttribute("aria-selected", String(selected));
        const panel = document.getElementById(other.getAttribute("aria-controls") ?? "");
        if (panel) panel.hidden = !selected;
      }
    });
  }
</script>
